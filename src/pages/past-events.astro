---
import DefaultLayout from '../layouts/default.astro';
import EventList from '../components/EventList.vue';
import MonthNav from '../components/MonthNav.vue';
import StaticEventList from '../components/StaticEventList.astro';
import { loadStaticEvents } from '../lib/staticEventList';

// Disable prerendering to enable SSR
export const prerender = false;

// Resolve the fallback before streaming so a load failure cannot be cached.
const staticEvents = await loadStaticEvents('past');
Astro.locals.staticEventListLoaded = staticEvents.success;
Astro.response.headers.set(
  'Cache-Control',
  staticEvents.success
    ? 'private, max-age=300, stale-while-revalidate=60'
    : 'private, no-store'
);
---

<DefaultLayout title="Past accessibility events">
  <div class="container grid">
    <div
      id="past-events"
      role="region"
      aria-labelledby="past-events-heading"
      class="py-l readable main-content"
    >
      <h1 id="past-events-heading" class="sr-only">
        Past accessibility events
      </h1>
      <EventList type="past" client:load />
      <noscript>
        <StaticEventList type="past" result={staticEvents} />
      </noscript>
    </div>
    <MonthNav
      id="month-nav"
      class="mb-l"
      client:idle
      contentRegion="#past-events"
    />
  </div>
  <!-- End container -->
</DefaultLayout>
