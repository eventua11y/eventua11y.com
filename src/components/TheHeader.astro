---
import Logo from '../images/eventua11y_logo_wordmark_white.svg';
const currentPath = Astro.url.pathname;
const topicPagesEnabled = Astro.locals.flags.topic_pages_enabled;
---

<header id="global-header" class="masthead">
  <div class="inner">
    <div class="masthead__logo">
      <a href="/" rel="home">
        <Logo class="logo" aria-label="Eventua11y" />
      </a>
    </div>
    <div class="masthead__actions">
      <nav class="primaryNav">
        <ul role="list" class="primaryNav__list">
          <li class="primaryNav__item">
            <a
              class="primaryNav__link"
              href="/"
              aria-current={currentPath === '/' ? 'page' : undefined}
            >
              Upcoming
            </a>
          </li>
          <li class="primaryNav__item">
            <a
              class="primaryNav__link"
              href="/past-events"
              aria-current={currentPath === '/past-events' ? 'page' : undefined}
            >
              Past Events
            </a>
          </li>
          {
            topicPagesEnabled && (
              <li class="primaryNav__item">
                <a
                  class="primaryNav__link"
                  href="/topics"
                  aria-current={
                    currentPath.startsWith('/topics') ? 'page' : undefined
                  }
                >
                  Topics
                </a>
              </li>
            )
          }
        </ul>
      </nav>
      <wa-button id="theme-selector-button" variant="brand" appearance="plain">
        <wa-icon name="moon" label="Switch to dark mode"></wa-icon>
      </wa-button>
    </div>
  </div>
</header>
<!-- End #global-header -->
