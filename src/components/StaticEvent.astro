---
/**
 * Server-rendered event card for the <noscript> fallback.
 *
 * This is a simplified Astro version of Event.vue that renders
 * HTML without any client-side interactivity.
 * Timed events use their own timezone.
 */
import dayjs from '../lib/dayjs';
import {
  storedCalendarDate,
  usesStoredCalendarDate,
} from '../../netlify/edge-functions/lib/dateUtils';
import type { Event } from '../types/event';
import { getEventUrl } from '../utils/eventUtils';
import { formatDateRange } from '../utils/dateUtils';
import StaticEventDate from './StaticEventDate.astro';

interface Props {
  event: Event;
  isPast?: boolean;
}

const { event, isPast = false } = Astro.props;

const isDeadline = event.type === 'deadline';
const isTheme = event.type === 'theme';
const headingId = `event-title-${event._id}`;
const isAllDay = event.day === true;
const preserveCalendarDate = usesStoredCalendarDate(event);
const dateStart = preserveCalendarDate
  ? storedCalendarDate(event.dateStart)
  : event.dateStart;
const dateEnd =
  preserveCalendarDate && event.dateEnd
    ? storedCalendarDate(event.dateEnd)
    : event.dateEnd;
const isInternational = !event.timezone;

// CFS open check
const callForSpeakersOpen =
  event.callForSpeakers &&
  (!event.callForSpeakersClosingDate ||
    new Date() < new Date(event.callForSpeakersClosingDate));

// Machine-readable datetime formatting
function formatDate(date: string, format: string): string {
  const parsed = dayjs.utc(date);
  const displayDate =
    !isDateOnly && event.timezone ? parsed.tz(event.timezone) : parsed;
  return displayDate.format(format);
}

// Human-readable date range with locale-aware deduplication
const formattedRange = formatDateRange({
  dateStart,
  dateEnd,
  timezone: preserveCalendarDate ? undefined : event.timezone,
  day: isAllDay,
  type: event.type,
  isDeadline,
  isPast,
  locale: 'en',
});

// Internal event page URL (if slug exists)
const eventUrl = getEventUrl(event);

// Machine-readable datetime values for <time> elements
const isDateOnly = isAllDay || isTheme || isDeadline;
const machineFormat = isDateOnly ? 'YYYY-MM-DD' : 'YYYY-MM-DDTHH:mm:ssZ';
const machineStart = formatDate(dateStart, machineFormat);
const machineEnd = dateEnd ? formatDate(dateEnd, machineFormat) : undefined;
let timezoneAbbreviation: string | undefined;
if (!isInternational && !preserveCalendarDate) {
  timezoneAbbreviation =
    !isDateOnly && event.timezone
      ? dayjs.utc(event.dateStart).tz(event.timezone).format('z')
      : 'UTC';
}

// Attendance mode display
const attendanceMode = event.attendanceMode || 'none';
const displayLocation = event.location || 'International';
const showLocation = ['offline', 'none'].includes(attendanceMode);
const showWebsiteLink = event.website && !isTheme;
const showDescription = event.description && !isTheme;
const showFreeBadge = event.isFree && !isTheme;
const showBadges = callForSpeakersOpen || showFreeBadge;
---

{isDeadline ? (
  <div class="event event--deadline">
    <StaticEventDate
      machineStart={machineStart}
      machineEnd={machineEnd}
      formattedRange={formattedRange}
      timezone={timezoneAbbreviation}
      isDeadline
    />
    <span class="event__title">
      Submit proposals for <a href={eventUrl || event.website}>{event.title}</a>
    </span>
  </div>
) : event.type ? (
  <article class={`event event--${event.type}`} data-event-type={event.type}>
    <h3 id={headingId} class="event__title">
      {eventUrl ? (
        <a href={eventUrl}>{event.title}</a>
      ) : (
        <span>{event.title}</span>
      )}
    </h3>

    {event.dateStart && (
      <StaticEventDate
        machineStart={machineStart}
        machineEnd={machineEnd}
        formattedRange={formattedRange}
        timezone={timezoneAbbreviation}
      />
    )}

    {event.type !== 'deadline' && (
      <div class="event__delivery text-small">
        {attendanceMode === 'online' && (
          <span class="event__online">Online</span>
        )}
        {showLocation && (
          <span class="event__location">
            <span>{displayLocation}</span>
          </span>
        )}
        {attendanceMode === 'mixed' && (
          <div>
            <span class="event__location">
              <span>{displayLocation}</span>
            </span>
            <span class="text-muted"> and </span>
            <span class="event__online">Online</span>
          </div>
        )}
        {showWebsiteLink && (
          <Fragment>
            <span aria-hidden="true" class="event__delivery-separator">
              ·
            </span>
            <a
              href={event.website}
              rel="external noopener noreferrer"
              class="event__website-link"
              aria-describedby={headingId}
            >
              Event website<span class="sr-only"> (opens external site)</span>
            </a>
          </Fragment>
        )}
      </div>
    )}

    {showDescription && (
      <details class="event__children flow">
        <summary>Description</summary>
        <p class="event__description">{event.description}</p>
      </details>
    )}

    {showBadges && (
      <div class="event__badges">
        {callForSpeakersOpen && (
          <span class="badge badge--success">Call for speakers</span>
        )}
        {showFreeBadge && <span class="badge">Free</span>}
      </div>
    )}
  </article>
) : null}
