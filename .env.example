# FontAwesome kit code (used by src/layouts/default.astro).
FA_KIT_CODE=

# Optional PostHog browser analytics and Astro error tracking.
# Enable Cookieless tracking in the PostHog project before configuring the key.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Optional PostHog browser source-map upload. Set in Netlify Builds scope.
# Use a secret personal API key with Error Tracking write and Organization read.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
