{
  "name": "eventua11y",
  "version": "1.0.0",
  "description": "A curated list of digital accessibility events",
  "scripts": {
    "test": "npx playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:ui": "npx playwright test --ui",
    "bench": "vitest bench --run",
    "dev": "concurrently \"astro dev\" \"npm run check:watch\"",
    "start": "astro dev",
    "build": "npm run check && astro build",
    "posthog:sourcemaps": "posthog-cli --host https://eu.posthog.com sourcemap process --release-name eventua11y-web --delete-after",
    "preview": "astro preview",
    "check": "prettier --check .",
    "check:watch": "concurrently \"prettier --watch . --write\" \"eslint . --fix --watch\"",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "knip": "knip",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:fix": "fallow fix --dry-run",
    "check:freshness": "node scripts/check-event-freshness.mjs",
    "chocks": "chocks -p 5959"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eventua11y/eventua11y.com.git"
  },
  "author": "Matt Obee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eventua11y/eventua11y.com/issues"
  },
  "homepage": "https://github.com/eventua11y/eventua11y.com#readme",
  "resolutions": {
    "astro": "^7.4.12"
  },
  "overrides": {
    "vue": "^3.5.45",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/compiler-core": "^3.5.45",
    "@vue/compiler-dom": "^3.5.45",
    "@fastify/static": "^10.1.2",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codspeed/vitest-plugin": "^6.1.1",
    "@eslint/js": "^10.0.1",
    "@mattobee/chocks": "^0.8.0",
    "@playwright/test": "^1.65.1",
    "@portabletext/types": "^4.0.2",
    "@posthog/cli": "^0.20.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "astro": "^7.4.12",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.6",
    "cssnano": "^9.9.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.12.0",
    "fallow": "^3.46.0",
    "globals": "^17.13.0",
    "knip": "^6.44.2",
    "netlify-cli": "^27.20.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.1.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.12",
    "@astrojs/vue": "^7.0.2",
    "@awesome.me/webawesome": "^3.15.0",
    "@sanity/client": "^8.9.0",
    "astro-portabletext": "^1.0.1",
    "dayjs": "^1.11.23",
    "posthog-js": "^1.455.4",
    "posthog-node": "^6.2.0",
    "vue": "^3.5.45"
  }
}
